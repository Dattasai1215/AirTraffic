# Frontend Configuration

# Public OpenSky Network API (Free, no key needed)
VITE_OPENSKY_URL=https://opensky-network.org/api/states/all

# Backend API (if running Python backend)
VITE_API_BASE_URL=http://localhost:8000
# Legacy support: VITE_BACKEND_URL is also accepted
VITE_BACKEND_URL=http://localhost:8000

# Vite base path for production builds
# Use /AirTraffic/ for GitHub Pages, / for root deployments
VITE_BASE_PATH=/

# Update interval in milliseconds
VITE_REFRESH_INTERVAL=10000

# Tracking region (New York by default)
# Change coordinates for different regions
VITE_MAP_LAT_MIN=39.5
VITE_MAP_LAT_MAX=41.5
VITE_MAP_LON_MIN=-75.0
VITE_MAP_LON_MAX=-72.0

# Map center
VITE_MAP_CENTER_LAT=40.5
VITE_MAP_CENTER_LON=-73.5
VITE_MAP_ZOOM=8
